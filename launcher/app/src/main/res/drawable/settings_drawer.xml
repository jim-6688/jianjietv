<?xml version="1.0" encoding="utf-8"?>
<!-- Right-side drawer: the same charcoal the top bar is painted with (top_bar_bg, #0B0F14), a touch see-through
     so it still reads as a layer over Home rather than a new window, rounded on the left edge only so the right
     edge sits flush against the screen. Used by the in-home settings panel and the film sources page.

     The colour matches the bar on purpose: over Home's black background the old darker fill (#070B10, and at
     lower opacity) read as one black hole next to the bar. Keep these values in step with top_bar_bg.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F20B0F14"
        android:centerColor="#EB0B0F14"
        android:endColor="#E30B0F14" />
    <stroke android:width="1dp" android:color="#33FFFFFF" />
    <corners
        android:topLeftRadius="22dp"
        android:bottomLeftRadius="22dp"
        android:topRightRadius="0dp"
        android:bottomRightRadius="0dp" />
</shape>
