<?xml version="1.0" encoding="utf-8"?>
<!-- Dark frosted glass behind a big app card (or a banner with transparent parts): a deep charcoal
     gradient with a soft rim, so the white in-card name stays legible over bright wallpapers.
     The 24dp radius matches AppAdapter.cornerRadius and the outline clip. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#DE0B1119"
        android:centerColor="#C20B1119"
        android:endColor="#A50B1119" />
    <stroke android:width="1dp" android:color="#3DFFFFFF" />
    <corners android:radius="24dp" />
</shape>
