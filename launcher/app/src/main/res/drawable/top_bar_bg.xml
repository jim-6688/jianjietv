<?xml version="1.0" encoding="utf-8"?>
<!-- Solid top bar behind the clock, IP line and the Wi-Fi / settings pills. Opaque charcoal with a
     faint hairline at the bottom edge so it reads as a real bar, not a gradient scrim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0B0F14" />
        </shape>
    </item>
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="2dp" />
            <solid android:color="#1FFFFFFF" />
        </shape>
    </item>
</layer-list>
