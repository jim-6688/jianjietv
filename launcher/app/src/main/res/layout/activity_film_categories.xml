<?xml version="1.0" encoding="utf-8"?>
<!-- Down-arrow film-categories panel: a dimmed backdrop (tap outside to close) with a centred frosted
     card of 影视 categories. Selecting one opens the 影视 app (best-effort jumps to that category). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="1040dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/settings_panel"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="36dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="影视分类"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/cat0" style="@style/FilmCategory" android:tag="电影" android:text="电影" />
            <TextView android:id="@+id/cat1" style="@style/FilmCategory" android:tag="电视剧" android:text="电视剧" />
            <TextView android:id="@+id/cat2" style="@style/FilmCategory" android:tag="综艺" android:text="综艺" />
            <TextView android:id="@+id/cat3" style="@style/FilmCategory" android:tag="动漫" android:text="动漫" />
            <TextView android:id="@+id/cat4" style="@style/FilmCategory" android:tag="纪录片" android:text="纪录片" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/cat5" style="@style/FilmCategory" android:tag="解说" android:text="解说" />
            <TextView android:id="@+id/cat6" style="@style/FilmCategory" android:tag="短剧" android:text="短剧" />
            <TextView android:id="@+id/cat7" style="@style/FilmCategory" android:tag="少儿" android:text="少儿" />
            <TextView android:id="@+id/cat8" style="@style/FilmCategory" android:tag="体育" android:text="体育" />
            <TextView android:id="@+id/cat9" style="@style/FilmCategory" android:tag="音乐" android:text="音乐" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="选择分类打开影视 · 返回键关闭"
                android:textColor="#FFACB8C1"
                android:textSize="14sp" />

            <!-- 打开「影视源」面板：内置源做成按钮，点一下即切换影视 App 的源。 -->
            <TextView
                android:id="@+id/sourceEntry"
                android:layout_width="220dp"
                android:layout_height="52dp"
                android:background="@drawable/settings_choice_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="换源"
                android:textColor="#FFFFFFFF"
                android:textSize="19sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
