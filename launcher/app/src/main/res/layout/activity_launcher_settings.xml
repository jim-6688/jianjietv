<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:background="#99000000">

    <!-- 贴屏幕右侧的抽屉：全高、左侧圆角，首页本身不清屏、不新开窗口。 -->
    <ScrollView
        android:id="@+id/panel"
        android:layout_width="460dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/settings_drawer"
        android:clickable="true"
        android:focusable="false"
        android:fillViewport="true"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <!-- 收藏壁纸：置于设置最上方，右侧胶囊预览当前收藏，点击进入壁纸列表。 -->
        <LinearLayout
            android:id="@+id/wallpaperFavoritesChoice"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="@drawable/settings_choice_bg"
            android:focusable="true"
            android:clickable="true">

            <TextView
                android:id="@+id/wallpaperFavoritesText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/wallpaperFavoritesThumb"
                android:layout_width="76dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:scaleType="centerCrop"
                android:background="@drawable/capsule_bg"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 桌面设置（分区小字标题已去掉，保留选项行） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="@string/app_count_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/appCount3" style="@style/SettingsColumnChoice" android:text="3" />
            <TextView android:id="@+id/appCount4" style="@style/SettingsColumnChoice" android:text="4" />
            <TextView android:id="@+id/appCount5" style="@style/SettingsColumnChoice" android:text="5" />
            <TextView android:id="@+id/appCount6" style="@style/SettingsColumnChoice" android:text="6" />
            <TextView android:id="@+id/appCount7" style="@style/SettingsColumnChoice" android:text="7" />
            <TextView android:id="@+id/appCount8" style="@style/SettingsColumnChoice" android:text="8" />
        </LinearLayout>

        <!-- 背景透明度：同一个 dock_opacity 也套在顶栏、天气卡和设置抽屉上，见 MainActivity.applyCardOpacity()。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/dock_opacity_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
            <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
            <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
            <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30%" />
        </LinearLayout>

        <!-- 壁纸设置：类型二选一 + 当前类型内容 + 轮换方式，全部内联在面板里，不再进入二级页面。 -->
        <LinearLayout
            android:id="@+id/wallpaperInline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:orientation="vertical" />

        <!-- 影视源 -->
        <TextView
            android:id="@+id/filmSourcesChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="34dp"
            android:text="@string/film_sources" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>
