<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Time-of-day backdrop, drawn once a minute (config.xml sky_intensity; 0 keeps it hidden). -->
    <com.gathin.tvhome.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Cinematic top shelf (cinematic_home): the focused dock app's artwork, a few pixels across and
         stretched over the screen, which softens it like a blur without the cost of one. Hidden otherwise. -->
    <ImageView
        android:id="@+id/heroArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:alpha="0"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Race-weekend panel (a theme's race_calendar, see RaceWeekend): in the free space under the clock,
         shown only from shortly before a weekend's first session until the race is over. Updated once a
         minute with the clock, never animated. -->
    <LinearLayout
        android:id="@+id/racePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginStart="60dp"
        android:layout_marginTop="158dp"
        android:orientation="vertical"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- A short kerb-red bar, the panel's one accent. -->
            <View
                android:layout_width="3dp"
                android:layout_height="13dp"
                android:layout_marginEnd="10dp"
                android:id="@+id/raceBar"
                android:background="@drawable/race_bar" />

            <TextView
                android:id="@+id/raceKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.22"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/raceHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:fontFamily="@string/font_light"
            android:letterSpacing="-0.01"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/raceSessions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.12" />

        <!-- game_day: one dot per turn when the panel rotates between games (and the F1 weekend). -->
        <LinearLayout
            android:id="@+id/racePager"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Cinematic top shelf: darkens the edge behind the shelf and the lower half, so the text and the
         dock stay readable over the artwork. -->
    <View
        android:id="@+id/heroScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:orientation="vertical"
        android:alpha="0">

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="48sp"
            android:fontFamily="@string/font_light"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:singleLine="true" />

        <!-- Cinematic shelf only: when the app was last opened, and the dock position dots. -->
        <TextView
            android:id="@+id/heroMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@string/font_light"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/heroDots"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Solid top bar: one opaque strip behind the clock / IP line and the Wi-Fi + settings pills.
         Drawn above the wallpaper and the ambient layers, below the header content. -->
    <View
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_gravity="top"
        android:background="@drawable/top_bar_bg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 顶栏一行：左边文字块（问候 / 时间 / 日期 / 网络信息）贴左，右边一排按钮贴右，
             中间用 weight 撑开；垂直方向仍然居中于顶栏实色条。网络信息那一段由代码按剩余宽度
             收窄，行宽始终不会撑破屏幕。 -->
        <LinearLayout
            android:id="@+id/headerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- 文字块竖排：上面是那一行文字；show_stats 打开时，统计行跟在它下面。
                 weight=1 占满按钮左边的空间，把按钮推到顶栏最右侧。 -->
            <LinearLayout
                android:id="@+id/headerTexts"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- 顶栏单行横排：问候 / 时间 / 日期 / 本机IP / 外网IP / 连接类型，全部一行、同一套字体。 -->
                <LinearLayout
                    android:id="@+id/leftBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">

                    <TextView
                        android:id="@+id/greeting"
                        android:gravity="left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="#CBB68C"
                        android:textSize="20sp"
                        android:fontFamily="serif"
                        android:letterSpacing="0.04"
                        android:textAllCaps="true" />

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#EAD9B2"
                        android:textSize="30sp"
                        android:fontFamily="serif"
                        android:letterSpacing="-0.01"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#BFAE86"
                        android:textSize="16sp"
                        android:fontFamily="serif"
                        android:textAllCaps="true" />

                    <!-- 单行布局里不再需要竖线；保留 id 供旧代码引用（header_white 等），默认隐藏。 -->
                    <View
                        android:id="@+id/clockDivider"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="gone" />

                    <TextClock
                        android:id="@+id/date"
                        android:gravity="left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:format12Hour="@string/date_format_home"
                        android:format24Hour="@string/date_format_home"
                        android:textColor="#D6C39B"
                        android:textSize="20sp"
                        android:fontFamily="serif"
                        android:letterSpacing="0.02" />

                    <!-- 可选：波斯历 / 农历，开启时也接在同一行（默认隐藏）。 -->
                    <TextView
                        android:id="@+id/shamsiDate"
                        android:gravity="left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="#D6C39B"
                        android:textSize="20sp"
                        android:fontFamily="serif"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/lunarDate"
                        android:gravity="left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="#CBB68C"
                        android:textSize="20sp"
                        android:fontFamily="serif"
                        android:visibility="gone" />

                    <!-- 默认只显示入口宽带运营商名称与连接类型；设置里打开「显示 IP」后换成
                         内网 / 外网两行。内容由 NetInfo 异步填充，宽度由代码按「这一行还剩多少」
                         收窄（maxWidth），不会把右边的按钮挤出屏幕。 -->
                    <TextView
                        android:id="@+id/networkInfo"
                        android:gravity="left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:maxWidth="480dp"
                        android:maxLines="2"
                        android:lineSpacingExtra="1dp"
                        android:ellipsize="end"
                        android:textColor="#CBB68C"
                        android:textSize="18sp"
                        android:fontFamily="serif"
                        android:letterSpacing="0.01"
                        android:includeFontPadding="false"
                        android:importantForAccessibility="no" />

                </LinearLayout>

                <!-- Shown only when show_stats is on. Under the text row, so the top buttons stay level with the
                     clock row; gone, it takes no space. -->
                <TextView
                    android:id="@+id/stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="left"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="#D9FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@string/font_medium"
                    android:letterSpacing="0.04"
                    android:focusable="false"
                    android:visibility="gone" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButtonLarge"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButtonLarge"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnVpn"
                    style="@style/TopButtonLarge"
                    android:visibility="gone"
                    android:singleLine="true"
                    android:text="@string/vpn"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnReorder"
                    style="@style/TopButtonIcon"
                    android:contentDescription="@string/reorder"
                    android:drawableStart="@drawable/ic_swap_vert"
                    android:nextFocusDown="@+id/grid" />

                <!-- 一键收藏当前壁纸（空心星：未收藏，实心金星：已收藏）；长按打开壁纸喜好列表。 -->
                <TextView
                    android:id="@+id/btnFavorite"
                    style="@style/TopButtonIcon"
                    android:contentDescription="@string/wallpaper_favorite_add"
                    android:drawableStart="@drawable/ic_star_outline"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnLibraryTop"
                    style="@style/TopButtonIcon"
                    android:visibility="gone"
                    android:contentDescription="@string/app_library"
                    android:drawableStart="@drawable/ic_apps_pill"
                    android:nextFocusDown="@+id/grid" />

                <!-- 内容页入口：豆瓣海报墙。方向键「向下到底」仍是直接开影视 App，这个按钮只负责展示内容。 -->
                <TextView
                    android:id="@+id/btnFilmHub"
                    style="@style/TopButtonLarge"
                    android:text="@string/film_hub"
                    android:drawableStart="@drawable/ic_film_pill"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButtonLarge"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </LinearLayout>

        <!-- 天气卡：顶栏实色条上下对称留白后会比头部低约 20dp，这里下移把间距留回来，
             天气卡不再与顶栏叠在一起（也不压到屏幕最底部）。 -->
        <!-- Home weather: big readout on a frosted-glass panel — a translucent fill with a crisp rim
             so it keeps an outline over the weather wallpaper, with the wallpaper showing through.
             Left: glyph + temperature + city. Right of the divider: a 3-day forecast column. -->
        <LinearLayout
            android:id="@+id/homeWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/frosted_panel"
                android:paddingStart="28dp"
                android:paddingEnd="30dp"
                android:paddingTop="12dp"
                android:paddingBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/weatherLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/homeWeatherGlyph"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="26dp"
                            android:textColor="#FFFFFFFF"
                            android:textSize="104sp"
                            android:fontFamily="@string/font_regular"
                            android:includeFontPadding="false"
                            android:shadowColor="#80000000"
                            android:shadowDx="0"
                            android:shadowDy="3"
                            android:shadowRadius="14" />

                        <TextView
                            android:id="@+id/homeWeatherTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFFFF"
                            android:textSize="104sp"
                            android:fontFamily="@string/font_light"
                            android:letterSpacing="-0.04"
                            android:includeFontPadding="false"
                            android:shadowColor="#80000000"
                            android:shadowDx="0"
                            android:shadowDy="3"
                            android:shadowRadius="14" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/homeWeatherCity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="#E6FFFFFF"
                        android:textSize="28sp"
                        android:fontFamily="@string/font_regular"
                        android:letterSpacing="0.05"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="10" />
                </LinearLayout>

                <View
                    android:id="@+id/weatherDivider"
                    android:layout_width="1dp"
                    android:layout_height="96dp"
                    android:layout_marginStart="28dp"
                    android:layout_marginEnd="24dp"
                    android:background="#40FFFFFF" />

                <!-- 3 天预报（今天/明天/后天），取不到数据时整列隐藏。 -->
                <LinearLayout
                    android:id="@+id/homeWeatherDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/homeWeatherDay0"
                        style="@style/WeatherDay" />

                    <TextView
                        android:id="@+id/homeWeatherDay1"
                        style="@style/WeatherDay" />

                    <TextView
                        android:id="@+id/homeWeatherDay2"
                        style="@style/WeatherDay" />
                </LinearLayout>
            </LinearLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
