<?xml version="1.0" encoding="utf-8"?>
<!-- A big 16:9 app card. Width and height are set from the grid in AppAdapter.onCreateViewHolder.
     The card is the app itself: a TV banner (also 16:9) is shown whole with fitCenter, so it fills
     the card exactly - no black bars, no cropping, no stretching. Apps without a banner get a large
     icon centred on a tinted card. Banner cards carry no caption and no scrim; the name sits in the
     line under the card (shown on focus, or always with always_show_names). Only icon tiles print
     their name inside. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="320dp"
        android:layout_height="180dp"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/tile_bg"
        android:focusable="true"
        android:clickable="true">

        <ImageView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <!-- AppAdapter sizes this to 50% of the card height. fitCenter keeps the aspect ratio: an app
             icon stretched to fill a square slot was what made the big icons look distorted. -->
        <ImageView
            android:id="@+id/icon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:gravity="start|bottom"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.01"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/name"
        android:layout_width="320dp"
        android:layout_height="18dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="184dp"
        android:includeFontPadding="false"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:alpha="0"
        android:translationY="-6dp"
        android:textColor="#F2FFFFFF"
        android:textSize="13sp"
        android:fontFamily="@string/font_medium"
        android:letterSpacing="0.02" />
</FrameLayout>
