<?xml version="1.0" encoding="utf-8"?>
<!-- 影视墙海报卡：深色圆角卡，顶部一条分类色条，居中彩色 emoji，底部分类名（最近观看时显示时间）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/poster"
    android:layout_width="300dp"
    android:layout_height="170dp"
    android:background="@drawable/poster_card"
    android:focusable="true"
    android:clickable="true">

    <!-- 分类色条，颜色在代码里按分类设置 -->
    <View
        android:id="@+id/accent"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:background="#FFE7B400" />

    <!-- 居中彩色 emoji 作为无海报时的占位 -->
    <TextView
        android:id="@+id/emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="18dp"
        android:textSize="76sp"
        android:includeFontPadding="false"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="10" />

    <!-- 真实海报（网络加载），盖在 emoji 上；没加载出来时露出 emoji -->
    <ImageView
        android:id="@+id/posterImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- 底部渐变，保证分类名在任何色块上都看得清 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/poster_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="19sp"
            android:fontFamily="@string/font_medium"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#C7D4E0FF"
            android:textSize="13sp"
            android:fontFamily="@string/font_regular"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
