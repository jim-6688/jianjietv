<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 顶栏：标题 + 副标题（主页无返回键） -->
    <LinearLayout
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="2dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_brand"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface" />

            <TextView
                android:id="@+id/headerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                style="@style/StatusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_icon_circle"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_smartphone" />

                    <TextView
                        android:id="@+id/deviceStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="尚未连接电视"
                        android:textSize="15sp"
                        android:textColor="@color/on_surface" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:paddingStart="4dp"
                android:text="设备操作"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface_variant" />

            <FrameLayout
                android:id="@+id/btnBrand"
                style="@style/FeatureCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <include layout="@layout/row_feature" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnScan"
                style="@style/FeatureCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <include layout="@layout/row_feature" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnSetup"
                style="@style/FeatureCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <include layout="@layout/row_feature" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnRemote"
                style="@style/FeatureCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <include layout="@layout/row_feature" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnApps"
                style="@style/FeatureCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <include layout="@layout/row_feature" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnSources"
                style="@style/FeatureCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <include layout="@layout/row_feature" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnSync"
                style="@style/FeatureCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <include layout="@layout/row_feature" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:paddingStart="4dp"
                android:text="更多"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface_variant" />

            <FrameLayout
                android:id="@+id/btnMore"
                style="@style/FeatureCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <include layout="@layout/row_feature" />
            </FrameLayout>

            <FrameLayout
                style="@style/StatusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_icon_circle"
                        android:padding="7dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_shield" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="安全约定：系统应用只禁用不卸载；核心包一律不动；ADB 保持开启时可随时一键关闭并校验 5555 端口。"
                        android:textSize="13sp"
                        android:textColor="@color/on_surface_variant"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="v0.1 · 纯本地运行，不上传任何数据"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
