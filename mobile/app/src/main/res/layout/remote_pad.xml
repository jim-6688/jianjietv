<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:paddingStart="4dp"
        android:text="方向键 / 确认"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface_variant" />

    <!-- 方向键十字 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout style="@style/RemoteKey" android:id="@+id/keyUp">
            <ImageView android:layout_width="26dp" android:layout_height="26dp"
                android:scaleType="centerInside" android:src="@drawable/ic_up" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="上" android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <LinearLayout style="@style/RemoteKey" android:id="@+id/keyLeft">
            <ImageView android:layout_width="26dp" android:layout_height="26dp"
                android:scaleType="centerInside" android:src="@drawable/ic_left" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="左" android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <LinearLayout style="@style/RemoteKey" android:id="@+id/keyOk">
            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                android:scaleType="centerInside" android:src="@drawable/ic_ok" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="确认" android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <LinearLayout style="@style/RemoteKey" android:id="@+id/keyRight">
            <ImageView android:layout_width="26dp" android:layout_height="26dp"
                android:scaleType="centerInside" android:src="@drawable/ic_right" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="右" android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout style="@style/RemoteKey" android:id="@+id/keyDown">
            <ImageView android:layout_width="26dp" android:layout_height="26dp"
                android:scaleType="centerInside" android:src="@drawable/ic_down" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="下" android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:paddingStart="4dp"
        android:text="常用"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface_variant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <LinearLayout style="@style/RemoteKey" android:id="@+id/keyBack">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:scaleType="centerInside" android:src="@drawable/ic_back" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="返回" android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <LinearLayout style="@style/RemoteKey" android:id="@+id/keyHome">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:scaleType="centerInside" android:src="@drawable/ic_home" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="主页" android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <LinearLayout style="@style/RemoteKey" android:id="@+id/keyMenu">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:scaleType="centerInside" android:src="@drawable/ic_menu" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="菜单" android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:paddingStart="4dp"
        android:text="音量"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface_variant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <LinearLayout style="@style/RemoteKey" android:id="@+id/keyVolDown">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:scaleType="centerInside" android:src="@drawable/ic_volume_down" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="音量-" android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <LinearLayout style="@style/RemoteKey" android:id="@+id/keyVolUp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:scaleType="centerInside" android:src="@drawable/ic_volume_up" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="音量+" android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <LinearLayout style="@style/RemoteKey" android:id="@+id/keyRecent">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:scaleType="centerInside" android:src="@drawable/ic_apps" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="最近任务" android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <LinearLayout style="@style/RemoteKey" android:id="@+id/keyPower">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:scaleType="centerInside" android:src="@drawable/ic_close" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="电源" android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="4dp"
        android:text="提示：电源键会令电视休眠/唤醒，谨慎使用；品牌专属键（如三星/LG）暂未接入，后续按品牌自动匹配。"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/on_surface_variant" />
</LinearLayout>
